DOMAIN_LIST=mail.example.com
DESEC_ZONE=example.com
MAILCOW_SSL_DIR=/opt/mailcow-dockerized/data/assets/ssl
TLSA_PORT=25
TIMEOUT_SECONDS=5
POLL_INTERVAL_SECONDS=300
